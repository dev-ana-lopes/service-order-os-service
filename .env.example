APP_NAME=service-order-os-service
APP_VERSION=0.1.0
ENVIRONMENT=development
APP_RUNTIME_MODE=real
LOG_LEVEL=INFO
LOG_JSON=false
EMAIL_PROVIDER=SMTP
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8000
TRUSTED_HOSTS=*

DATABASE_URL=postgresql+asyncpg://service_order_user:service_order_password@postgres:5432/service_order_db
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/%2F
RABBITMQ_EXCHANGE=service-order.events
RABBITMQ_ROUTING_KEY=service-order.os
RABBITMQ_QUEUE=service-order.os.events
RABBITMQ_CONSUME_ROUTING_KEYS=service-order.billing,service-order.execution
APP_BASE_URL=http://localhost:8000
HEALTHCHECK_TIMEOUT_SECONDS=5
MIGRATE_ON_STARTUP=false

SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_FROM_EMAIL=no-reply@localhost
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_PASSWORD_FILE=
SMTP_USE_TLS=false
SMTP_USE_AUTH=false
SMTP_TIMEOUT_SECONDS=10

TESTMAIL_API_KEY=
TESTMAIL_NAMESPACE=
TESTMAIL_ENABLED=false
TESTMAIL_API_BASE_URL=https://api.testmail.app/api/json

APPROVAL_TOKEN_SECRET=dev-approval-secret-with-32-characters
APPROVAL_TOKEN_SECRET_FILE=
APPROVAL_TOKEN_TTL_MINUTES=60
JWT_SECRET=dev-jwt-secret-with-at-least-32-chars
JWT_SECRET_FILE=
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=60

CUSTOMER_JWT_SECRET=customer-dev-secret-with-at-least-32-char
CUSTOMER_JWT_SECRET_FILE=
CUSTOMER_JWT_ALGORITHM=HS256
CUSTOMER_JWT_ISSUER=service-order-auth-lambda/development
DD_SERVICE=service-order-os-service
DD_ENV=production
DD_VERSION=3.0.0
DD_API_KEY=
OTEL_ENABLED=false
OTEL_SERVICE_NAME=service-order-os-service
OTEL_EXPORTER_OTLP_ENDPOINT=
DD_TRACE_ENABLED=false


